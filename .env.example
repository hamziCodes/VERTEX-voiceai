# ==============================================================================
# UCVE Voice Engine - Universal Environment Configuration Template (.env.example)
# Copy this file to .env in the root directory: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME MODE & PLATFORM SWITCHES
# ------------------------------------------------------------------------------
# UCVE_ENV: development | test | production
UCVE_ENV=development
UCVE_RUNTIME_PROFILE=dev

# RUN_LIVE_PROVIDERS: Set to 1 to send real network API calls to external cloud providers.
# Set to 0 to use local low-latency mock PCM audio engines (default for offline dev).
RUN_LIVE_PROVIDERS=0

# ------------------------------------------------------------------------------
# 2. CORE SYSTEM SECRETS (Required for session minting & security)
# ------------------------------------------------------------------------------
# Min 32-character secret keys used by Control Plane & Worker Node
UCVE_JWT_SECRET=ucve-jwt-secret-test-only-32bytes!
UCVE_MINT_HMAC_SECRET=dev-only-replace-me-mint-hmac-32
UCVE_METRICS_BEARER=dev-only-replace-me-metrics-bearer

# Public WebSocket URL returned to clients after minting a session
UCVE_WS_PUBLIC_URL=ws://localhost:8081/ws/audio

# Demo mode: allow unauthenticated POST /mint (auto-enabled when UCVE_ENV=development)
# Set to 0 to require API-key auth even in development; set to 1 to force on in any env.
# UCVE_DEMO_MODE=1
# UCVE_ALLOW_UNSAFE_SESSION_OVERRIDES=0
# Comma-separated CORS allowlist (never use wildcard with credentials in production)
UCVE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. CLOUD DATABASE & CACHE (State & Persistence)
# ------------------------------------------------------------------------------
# PostgreSQL (Supabase / AWS RDS / GCP Cloud SQL / Local Docker)
DATABASE_URL=postgresql://ucve:ucve_password@localhost:5432/ucve
# Fail fast instead of hanging when the database is unreachable (seconds).
UCVE_DB_CONNECT_TIMEOUT_S=3
UCVE_DB_POOL_TIMEOUT_S=5
UCVE_DB_TCP_USER_TIMEOUT_S=5

# Redis (Upstash / AWS ElastiCache / Local Docker)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. LLM PROVIDERS (Language Engines)
# ------------------------------------------------------------------------------
# Platform keys are read ONLY as PLATFORM_<PROVIDER>_API_KEY. Bare names such as
# GROQ_API_KEY, GOOGLE_API_KEY or GEMINI_API_KEY are ignored by the engine.
# Groq - default primary LLM
PLATFORM_GROQ_API_KEY=

# Google Gemini
PLATFORM_GEMINI_API_KEY=

# OpenAI
PLATFORM_OPENAI_API_KEY=

# Post-call intelligence (summary + extraction). Provider must have a platform
# key above (groq, gemini or openai); empty model uses that provider's default. Without a key, post-call
# jobs report "no post-call intelligence provider" instead of faking a summary.
WAVIA_POST_CALL_LLM_PROVIDER=groq
WAVIA_POST_CALL_LLM_MODEL=

# ------------------------------------------------------------------------------
# 5. SPEECH-TO-TEXT (STT) PROVIDERS
# ------------------------------------------------------------------------------
# Gladia (Real-time WebSocket STT) - Default Primary STT
PLATFORM_GLADIA_API_KEY=

# Deepgram (Nova-3 STT)
PLATFORM_DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 6. TEXT-TO-SPEECH (TTS) PROVIDERS
# ------------------------------------------------------------------------------
# Uplift Labs (Low-latency streaming TTS) - Default Primary TTS
PLATFORM_UPLIFT_API_KEY=
# Uplift Orator voice (Pakistani voices; speak English with natural accent).
# v_meklc281 = Info/Education V2 (best default for EN+UR mixed replies)
UPLIFT_VOICE_ID=v_meklc281
PLATFORM_UPLIFT_VOICE_ID=v_meklc281
UPLIFT_OUTPUT_FORMAT=PCM_16000_16
# ElevenLabs (English TTS alternative in demo console dropdown)
PLATFORM_ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
PLATFORM_ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Cartesia (Sonic TTS) — preferred cheap EN debug TTS in demo console
PLATFORM_CARTESIA_API_KEY=
# Habiba Phase 6c default Sonic voice UUID
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
PLATFORM_CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL_ID=sonic-2
CARTESIA_SAMPLE_RATE=16000
CARTESIA_VERSION=2025-04-16

# ------------------------------------------------------------------------------
# 7. TELEPHONY & SIP TRUNKS (Phone Calls Inbound/Outbound)
# ------------------------------------------------------------------------------
# Telnyx Call Control / Direct SIP
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Exact public WSS endpoint that terminates authenticated Telnyx media streams.
UCVE_TELEPHONY_MEDIA_PUBLIC_URL=
# Deliberate live-call safety gate. Keep 0 except during an approved certification.
RUN_LIVE_TELEPHONY=0
# Telnyx is the only supported carrier in this release.

# ------------------------------------------------------------------------------
# 8. OBJECT STORAGE (knowledge documents, recordings)
# ------------------------------------------------------------------------------
# Every service that parses knowledge or stores recordings must see the SAME
# store. Protected environments (staging/production) refuse the local fallback.
UCVE_KNOWLEDGE_S3_BUCKET=
# Optional S3-compatible endpoint (e.g. MinIO / S3Mock); empty = AWS S3.
UCVE_KNOWLEDGE_S3_ENDPOINT=
UCVE_RECORDING_S3_BUCKET=
UCVE_RECORDING_S3_ENDPOINT=
UCVE_RECORDING_STORAGE_REGION=
# Development-only local roots used when no bucket is set.
# UCVE_KNOWLEDGE_LOCAL_ROOT=hamza_local/knowledge_objects
# UCVE_RECORDING_LOCAL_ROOT=hamza_local/post_call_objects

# ------------------------------------------------------------------------------
# 9. ENVELOPE ENCRYPTION FOR STORED TENANT SECRETS
# ------------------------------------------------------------------------------
# UCVE_KMS_BACKEND: local (Fernet keyed by UCVE_MASTER_KEY) | aws (AWS KMS).
# Never switched implicitly: changing it requires re-encrypting stored secrets.
UCVE_KMS_BACKEND=local
# Required in production when UCVE_KMS_BACKEND=local (no default is accepted).
UCVE_MASTER_KEY=
# Used when UCVE_KMS_BACKEND=aws. Credentials come from the standard AWS chain
# (instance/task role, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
# Seconds a decrypted credential may stay in process memory.
# UCVE_SECRET_CACHE_TTL_SEC=600  (1-3600)

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
OTEL_EXPORTER_ENABLED=false
# OTEL_SERVICE_NAME overrides the per-service name; OTEL_BSP_SCHEDULE_DELAY_S
# sets the span export interval (default 2).
# Platform operational-alert webhook (HMAC-signed, header X-Wavia-Alert-Signature).
# Leave empty to record alerts as "not_configured" (still visible in /admin/operations).
WAVIA_ALERT_WEBHOOK_URL=
# >= 16 characters; required when WAVIA_ALERT_WEBHOOK_URL is set.
WAVIA_ALERT_WEBHOOK_SECRET=
# Jobs runner (python -m worker_jobs.main): seconds to finish in-flight work on
# SIGTERM, and 0 to start the process without scheduling (diagnostics only).
WAVIA_JOBS_DRAIN_S=30
WAVIA_JOBS_AUTOSTART=1
# worker-raw: on SIGTERM, refuse new calls and wait this long for live calls
# to end before exiting (keep the orchestrator's stop grace period longer).
WAVIA_DRAIN_TIMEOUT_S=120
# Shared admission cap across all workers: set explicitly, or it is
# max_sessions_per_worker (runtime profile) x UCVE_WORKER_REPLICAS.
UCVE_CLUSTER_MAX_SESSIONS=
UCVE_WORKER_REPLICAS=1
# OTLP/HTTP (JSON) collector base URL; spans go to <endpoint>/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ------------------------------------------------------------------------------
# 11. VOICE PIPELINE V2 (Production tuning — see docs/runbooks/voice-pipeline-tuning.md)
# ------------------------------------------------------------------------------
# UCVE_PIPELINE_V2: Comma-separated enabled phases (empty = legacy behavior).
# Phases: quick_wins,frame_slicing,vad_timing,noise_gate,pre_roll,barge_verify,
#         streaming_stt,speaking_hardening,tool_loop,rag_speculative,vad_worker,production
# UCVE_PIPELINE_V2=quick_wins,frame_slicing,vad_timing,noise_gate,pre_roll,barge_verify,streaming_stt,speaking_hardening,tool_loop,rag_speculative,vad_worker,production

# --- VAD tuning (§8.2) ---
UCVE_VAD_THRESHOLD=0.5
UCVE_VAD_MIN_SPEECH_MS=100
UCVE_VAD_MIN_SILENCE_MS=380
UCVE_VAD_PRE_SPEECH_MS=200
UCVE_NOISE_GATE_K=3.0
UCVE_NOISE_GATE_WINDOW=50
UCVE_NOISE_GATE_DEFAULT_FLOOR=0.015

# --- Barge-in tuning (§8.3) ---
UCVE_BARGE_VERIFY_WINDOW_MS=700
UCVE_BARGE_MIN_SUSTAINED_SPEECH_MS=300
UCVE_BARGE_TEXT_BACKUP_WORDS=3

# --- STT tuning (§8.4) ---
UCVE_GLADIA_ENDPOINTING=0.2
UCVE_GLADIA_RECEIVE_PARTIALS=true
# Empty = no mock text on false VAD triggers (dev only)
UCVE_STT_MOCK_TEXT=
UCVE_STT_CONNECT_TIMEOUT_MS=3000
UCVE_STT_RECONNECT_MAX_ATTEMPTS=3
UCVE_INGRESS_BACKPRESSURE_WARN_MS=100

# --- Speaking / TTS tuning (§8.5) ---
UCVE_TTS_CHUNK_SIZE_BYTES=8192
UCVE_EGRESS_PREBUFFER_MS=35
UCVE_TTS_FIRST_CHUNK_TIMEOUT_MS=3000
UCVE_TTS_INTER_CHUNK_TIMEOUT_MS=3000
UCVE_TTS_OVERALL_TIMEOUT_MS=30000

# --- LLM / chunking tuning (§8.6) ---
UCVE_CHUNKER_FIRST_WORDS=2
UCVE_CHUNKER_MIN_WORDS=3
UCVE_TOOL_FILLER_DELAY_MS=400

# --- Pipeline debug telemetry (§8.7) ---
# 1 = emit per-frame VAD metrics to client
UCVE_DEBUG_LISTENING=0
# 1 = log per-turn latency waterfall
UCVE_DEBUG_LATENCY=0

# Local RAG embeddings. Release images bake the pinned multilingual-e5-small
# bundle and set this already; for local runs fetch it with
#   python -m core.rag.embedders.download_model --dest <dir>
# UCVE_EMBEDDING_MODEL_PATH=/opt/wavia/models/multilingual-e5-small
# ONNX threads per embedding process.
WAVIA_EMBEDDING_THREADS=2

# ------------------------------------------------------------------------------
# 12. WAVIA STUDIO IDENTITY (WorkOS AuthKit + independent API JWT verification)
# ------------------------------------------------------------------------------
# Studio / Next.js. Generate a unique cookie password locally (32+ characters).
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
# Must exactly match a redirect URI registered in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WAVIA_CONTROL_PLANE_URL=http://127.0.0.1:8080
# Public API base shown to developers in Studio snippets (defaults to the above).
WAVIA_PUBLIC_API_URL=
# Fail closed unless this deployment explicitly selects offline, mock, or live.
WAVIA_VOICE_TEST_MODE=disabled

# FastAPI. Copy issuer/JWKS/audience metadata from the configured OIDC application.
# OIDC_AUDIENCE is optional only when the issued token has no audience claim.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
