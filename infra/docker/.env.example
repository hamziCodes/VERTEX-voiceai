# Docker Compose environment — copy to .env beside docker-compose.yml

POSTGRES_DB=ucve
POSTGRES_USER=ucve
POSTGRES_PASSWORD=change-me-local-only

UCVE_RUNTIME_PROFILE=dev
UCVE_ENABLE_LIVEKIT=false

OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Vault refs in staging/prod — never commit real values
UCVE_TENANT_API_KEY=vault:tenant/api-key
UCVE_MINT_HMAC_SECRET=vault:tenant/mint-hmac
