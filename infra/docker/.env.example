# Docker Compose environment — copy to .env beside docker-compose.yml
# Never commit real production secrets.

# --- Runtime mode ---
# development | test | production
# production refuses known-default JWT/mint/metrics secrets (fail closed).
UCVE_ENV=development

POSTGRES_DB=ucve
POSTGRES_USER=ucve
POSTGRES_PASSWORD=change-me-local-only

DATABASE_URL=postgresql://ucve:change-me-local-only@postgres:5432/ucve
REDIS_URL=redis://redis:6379/0

# Public WS URL returned by mint (host-reachable)
UCVE_WS_PUBLIC_URL=ws://localhost:8081/ws/audio

# Auth / crypto — replace before any non-local deploy
UCVE_JWT_SECRET=dev-only-replace-me-jwt-32chars-min
UCVE_MINT_HMAC_SECRET=dev-only-replace-me-mint-hmac-32
UCVE_METRICS_BEARER=dev-only-replace-me-metrics-bearer

# Dev-only Fernet master key (forbidden as sole KMS when UCVE_ENV=production)
UCVE_MASTER_KEY=

# Production KMS (required when UCVE_ENV=production — LocalDevKMS disabled)
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1

# Platform provider keys (server-side only)
PLATFORM_GLADIA_API_KEY=
PLATFORM_GROQ_API_KEY=
PLATFORM_UPLIFT_API_KEY=
# Optional alternate TTS
PLATFORM_CARTESIA_API_KEY=

UCVE_RUNTIME_PROFILE=dev
UCVE_ENABLE_LIVEKIT=false

OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Live provider E2E (manual/nightly only; CI stays mock)
RUN_LIVE_PROVIDERS=0
