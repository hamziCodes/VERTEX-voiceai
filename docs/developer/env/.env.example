# UCVE developer local environment — NO SECRETS
# Copy to .env and fill from Phase 09 vault in staging/prod.

# Control plane
UCVE_CONTROL_PLANE_URL=http://localhost:8080
UCVE_API_VERSION=v1

# Host-backend mint proxy (server-side only)
UCVE_TENANT_API_KEY=replace-with-vault-ref
UCVE_MINT_HMAC_SECRET=replace-with-vault-ref
UCVE_PUBLISHABLE_KEY=pk_test_replace_me

# Worker / WS
UCVE_WORKER_WS_URL=ws://localhost:8081/ws
UCVE_ENABLE_LIVEKIT=false

# Database (compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ucve
POSTGRES_USER=ucve
POSTGRES_PASSWORD=replace-with-local-dev-only

# Redis
REDIS_URL=redis://localhost:6379/0

# Observability (Phase 07)
OTEL_EXPORTER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Debug (never enable in prod)
UCVE_DEBUG_ERRORS=false

# Runtime profile (Phase 31)
UCVE_RUNTIME_PROFILE=dev
