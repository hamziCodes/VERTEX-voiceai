# AwaazLabs Client Dashboard â€” environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never be committed.
# Get these from the Clerk dashboard: Configure -> API Keys.

# ---------------------------------------------------------------------------------------
# Clerk (authentication) â€” REQUIRED. The app will not build or run without both.
# ---------------------------------------------------------------------------------------

# Public. Ships in the browser bundle by design. Safe to paste in a PR or a chat.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SECRET. Server-side only. Never commit it, never paste it into a chat or an issue.
# Anyone holding this can mint sessions for any user in your Clerk instance.
CLERK_SECRET_KEY=replace_with_clerk_secret_key

# Redirect target when middleware bounces an unauthenticated request. Without this, Clerk
# sends users to its hosted Account Portal on *.accounts.dev instead of our /sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# The Clerk organization whose members may use this dashboard.
#
# PRIMARY: the slug. It is stable across Clerk instances - a production instance mints a
# different organization ID for the same organization, but the slug carries over.
NEXT_PUBLIC_CLERK_ALLOWED_ORG_SLUG=healthcare-clinics

# FALLBACK: the organization ID. Set this too.
# Organization slugs are an optional Clerk feature. On an instance with them disabled, the
# session token's `orgSlug` can be null even for a legitimate member, and a slug-only check
# would lock the entire organization out. `orgId` is always present. Either one matching
# grants access.
#
# There is NO default for either. If neither is set, every request is denied. A locked-out
# deployment is loud and fixed in thirty seconds; one that silently admits the wrong
# organization to patient data is not.
NEXT_PUBLIC_CLERK_ALLOWED_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------------------------
# Dashboard API (Retell/Supabase live data) - REQUIRED for live Appointments/Escalations.
# ---------------------------------------------------------------------------------------

# Supabase Edge Function URL for dashboard-api.
DASHBOARD_API_URL=https://xyvsrxgxcjauyqzhomru.supabase.co/functions/v1/dashboard-api

# SECRET. Server-side only. Must match the Supabase Edge Function secret DASHBOARD_API_SECRET.
DASHBOARD_API_SECRET=replace_with_shared_dashboard_api_secret

# ---------------------------------------------------------------------------------------
# Clerk â€” OPTIONAL
# ---------------------------------------------------------------------------------------

# Only needed for a PRODUCTION Clerk instance, which serves from your own domain instead of
# *.clerk.accounts.dev. It is used to build the Content-Security-Policy in next.config.mjs;
# leaving it unset in production means Clerk's scripts are blocked by CSP.
# Example: https://clerk.dashboard.awaazlabs.com
# NEXT_PUBLIC_CLERK_FRONTEND_API_URL=

# ---------------------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------------------
#
# The dashboard also uses the server-only Dashboard API variables above for live Retell/Supabase
# Appointments and Escalations. The browser calls only the same-origin /api/dashboard proxy.
#
# Roles are NOT configured here. A user's role lives in their Clerk `publicMetadata`:
#     { "role": "OWNER_ADMIN" }   // or "MANAGER" or "VIEWER"
# An unknown or missing role fails closed to VIEWER. See src/shared/session-context.tsx.
