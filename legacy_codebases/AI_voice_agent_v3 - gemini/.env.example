# Speech-to-Text (Gladia)
GLADIA_API_KEY=""

# Language Model (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_MAX_HISTORY="6"

#Text-to-Speech (Uplift)
UPLIFT_API_KEY=""
UPLIFT_VOICE_ID="helpdesk-agent"

#CORS Origins for local development and production
CORS_ORIGINS="https://udru-voice-agent-finova.vercel.app,http://localhost:3000"

# Optional Silero VAD Configuration (Defaults shown below)
# VAD_THRESHOLD="0.55"
# MIN_SPEECH_DURATION_MS="250"
# MIN_SILENCE_DURATION_MS="250"
# VAD_SAMPLE_RATE="16000"
# VAD_WINDOW_SIZE_SAMPLES="512"