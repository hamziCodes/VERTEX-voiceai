# --- API Keys & Service Configuration ---
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file to version control.

# Phase 2: Speech-to-Text (Gladia)
GLADIA_API_KEY=""

# Phase 3: Language Model (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama3-8b-8192"
GROQ_MAX_HISTORY="6"

# Phase 4: Text-to-Speech (Uplift/Google/Azure/ElevenLabs)
UPLIFT_API_KEY=""
UPLIFT_VOICE_ID=""
ELEVENLABS_API_KEY="sk_your_key_here"
GOOGLE_TTS_API_KEY=""

# --- VAD Settings ---
VAD_THRESHOLD="0.5"
VAD_SPEECH_DURATION_MS="250" # 250ms voice onset check (prevents mouth-click false triggers)
VAD_SILENCE_UI_MS="200"      # 200ms local VAD silence for UI filler trigger
VAD_SILENCE_COMMIT_MS="600"  # 600ms silence for turn commit
VAD_ENERGY_THRESHOLD="0.015"
VAD_NOISE_GATE_K="3.0"
VAD_NOISE_GATE_WINDOW="50"

# --- Application Settings ---
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"