router = APIRouter(prefix="/api")

def _spec_with_availability(spec, settings):
    d = asdict(spec)
    d["configured"] = all(
        bool(getattr(settings, k, "")) for k in spec.requires_keys
    )
    return d

@router.get("/providers")
async def get_providers():
    """Returns full provider catalog with availability + compatibility matrix."""
    s = get_settings()
    return {
        "stt":  [_spec_with_availability(v, s) for v in STT_PROVIDERS.values()],
        "llm":  [_spec_with_availability(v, s) for v in LLM_PROVIDERS.values()],
        "tts":  [_spec_with_availability(v, s) for v in TTS_PROVIDERS.values()],
