### 5.2 Pipeline Security Guard

**File (NEW):** `backend/app/core/security.py`

```python
"""
PIPELINE SECURITY GUARD
=======================
Validates session configs before any connection is established.
Prevents injection, misconfiguration, and resource exhaustion.
"""
from backend.app.core.session_config import SessionConfig
from backend.app.services.registry import STT_PROVIDERS, LLM_PROVIDERS, TTS_PROVIDERS

class ConfigValidationError(ValueError):
    pass

class PipelineSecurityGuard:
    MAX_LANGUAGES = 6

    @classmethod
    def validate(cls, config: SessionConfig) -> list[str]:
        """Returns warnings list. Raises ConfigValidationError on fatal issues."""
        from backend.app.core.config.config import get_settings
        settings = get_settings()
        warnings = []

        # 1. WHITELIST CHECK — prevent injection of arbitrary provider names
        if config.stt_provider not in STT_PROVIDERS:
            raise ConfigValidationError(
                f"Unknown STT: '{config.stt_provider}'. Allowed: {list(STT_PROVIDERS)}"
            )
        if config.llm_provider not in LLM_PROVIDERS:
            raise ConfigValidationError(f"Unknown LLM: '{config.llm_provider}'.")
        for lang, tts in config.tts_overrides.items():
            if tts not in TTS_PROVIDERS:
                raise ConfigValidationError(f"Unknown TTS: '{tts}' for language '{lang}'.")

        # 2. API KEY PRESENCE — fail fast before connecting to any service
        stt_spec = STT_PROVIDERS[config.stt_provider]
        llm_spec = LLM_PROVIDERS[config.llm_provider]
        for key in stt_spec.requires_keys:
            if not getattr(settings, key, ""):
                raise ConfigValidationError(
                    f"STT '{config.stt_provider}' requires '{key}' in .env"
                )
        for key in llm_spec.requires_keys:
            if not getattr(settings, key, ""):
                raise ConfigValidationError(
                    f"LLM '{config.llm_provider}' requires '{key}' in .env"
                )

        # 3. LANGUAGE COUNT GUARD — prevent resource exhaustion
        if len(config.active_languages) > cls.MAX_LANGUAGES:
            raise ConfigValidationError(
                f"Max {cls.MAX_LANGUAGES} active languages per session."
            )
        if len(config.active_languages) == 0:
            raise ConfigValidationError("At least 1 active language required.")

        # 4. WARNINGS — non-fatal UX degradation notices
        if not stt_spec.live_streaming:
            warnings.append(
                f"⚠️ '{stt_spec.display_name}' is BATCH-only. "
                "No partial transcripts. +400ms per turn latency."
            )
        if config.llm_provider == "openrouter":
            warnings.append(
                "⚠️ OpenRouter free models rotate unpredictably. "
                "Do not use for client demos."
            )
        if "edge_tts" in config.tts_overrides.values():
            warnings.append(
                "⚠️ Edge TTS uses an unofficial API with no SLA. "
                "Dev testing only."
            )
        for lang in config.active_languages:
            if (lang not in stt_spec.languages
                    and "+" not in "".join(stt_spec.languages)):
                warnings.append(
                    f"⚠️ STT '{config.stt_provider}' may not support '{lang}'. Verify before demo."
                )

        return warnings
```

