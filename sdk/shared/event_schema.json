{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UCVERealtimeEvent",
  "description": "Canonical realtime event protocol for Wavia voice sessions.",
  "type": "object",
  "oneOf": [
    {
      "title": "ControlPong",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "enum": ["pong", "control.pong"] },
        "payload": { "type": "object" }
      }
    },
    {
      "title": "AudioStart",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "audio_start" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "server_send_ms", "clock_domain"],
          "properties": {
            "turn_id": { "type": "string", "format": "uuid" },
            "server_send_ms": { "type": "number" },
            "clock_domain": { "const": "server_monotonic_ms" }
          }
        }
      }
    },
    {
      "title": "ControlPlaybackStarted",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "control.playback_started" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "client_playback_started_ms", "client_clock_domain"],
          "properties": {
            "kind": { "const": "playback_started" },
            "turn_id": { "type": "string", "format": "uuid" },
            "client_clock_domain": { "const": "client_performance_ms" },
            "client_playback_started_ms": { "type": "number", "minimum": 0 },
            "client_scheduled_playback_ms": { "type": ["number", "null"] },
            "audio_context_time_sec": { "type": ["number", "null"] },
            "prebuffer_ms": { "type": ["number", "null"], "minimum": 0 },
            "underrun": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    {
      "title": "ControlBargeIn",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "control.barge_in" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "sequence"],
          "properties": {
            "rms": { "type": "number" },
            "t": { "type": "number" },
            "turn_id": { "type": ["string", "null"] },
            "sequence": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    {
      "title": "LegacyBargeIn",
      "description": "Deprecated until the next protocol major.",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "barge_in" },
        "payload": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "rms": { "type": "number" },
            "t": { "type": "number" }
          }
        }
      }
    },
    {
      "title": "ControlClearAudio",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "control.clear_audio" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "sequence"],
          "properties": {
            "turn_id": { "type": ["string", "null"] },
            "sequence": { "type": "integer", "minimum": 1 },
            "reason": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "ControlClearAudioAck",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "control.clear_audio_ack" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "sequence", "played_audio_ms"],
          "properties": {
            "turn_id": { "type": ["string", "null"] },
            "sequence": { "type": "integer", "minimum": 1 },
            "played_audio_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "title": "ControlPlaybackDrained",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "control.playback_drained" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "played_audio_ms"],
          "properties": {
            "turn_id": { "type": "string" },
            "played_audio_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "title": "AudioEnd",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "audio_end" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "generated_audio_ms"],
          "properties": {
            "turn_id": { "type": "string" },
            "generated_audio_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    {
      "title": "PlayedTextCommit",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "assistant.played_text_commit" },
        "payload": {
          "type": "object",
          "required": ["turn_id", "text", "played_audio_ms", "complete"],
          "properties": {
            "turn_id": { "type": "string" },
            "text": { "type": "string" },
            "played_audio_ms": { "type": "number", "minimum": 0 },
            "complete": { "type": "boolean" }
          }
        }
      }
    },
    {
      "title": "TextTurn",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "enum": ["text.turn", "text_turn", "user_turn"] },
        "payload": {
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      }
    },
    {
      "title": "Transcript",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "transcript" },
        "payload": {
          "type": "object",
          "required": ["speaker", "text"],
          "properties": {
            "speaker": { "type": "string", "enum": ["user", "agent"] },
            "text": { "type": "string" }
          }
        }
      }
    },
    {
      "title": "MetricWaterfall",
      "type": "object",
      "required": ["event_type", "payload"],
      "properties": {
        "event_type": { "const": "metric" },
        "payload": {
          "type": "object",
          "required": [
            "kind",
            "schema_version",
            "session_id",
            "turn_id",
            "clock_domain",
            "measurement_quality",
            "timestamps_ms",
            "durations_ms",
            "missing_reasons"
          ],
          "properties": {
            "kind": { "const": "latency" },
            "schema_version": { "const": "1.0" },
            "session_id": { "type": "string", "format": "uuid" },
            "turn_id": { "type": "string", "format": "uuid" },
            "clock_domain": { "const": "server_monotonic_ms" },
            "client_clock_domain": { "const": "client_performance_ms" },
            "measurement_quality": {
              "enum": [
                "incomplete",
                "playback_ack_only",
                "server_ack_upper_bound",
                "excluded"
              ]
            },
            "timestamps_ms": { "type": "object" },
            "durations_ms": { "type": "object" },
            "queue": { "type": "object" },
            "population": { "type": "object" },
            "missing_reasons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "excluded_reason": { "type": ["string", "null"] },
            "slo": { "type": "object" }
          }
        }
      }
    },
    {
      "title": "SessionEvent",
      "type": "object",
      "required": ["event_type"],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": ["session_ready", "audio_stop", "info", "error", "ping"]
        },
        "payload": { "type": "object" }
      }
    }
  ]
}
